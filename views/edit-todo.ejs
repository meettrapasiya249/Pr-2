<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Task | WorkOS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    :root {
      --primary: #6366f1;
      --bg-dark: #0f172a;
      --border-color: #e2e8f0;
    }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: #0f172a; /* Sophisticated dark background */
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    .edit-container {
      width: 100%;
      max-width: 500px;
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .back-link {
      display: inline-block;
      margin-bottom: 24px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
    }

    h2 {
      margin: 0 0 32px 0;
      font-size: 24px;
      font-weight: 800;
      color: #1e293b;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    input, textarea, select {
      width: 100%;
      padding: 14px;
      margin-bottom: 24px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      box-sizing: border-box;
      font-size: 15px;
      background-color: #f8fafc;
    }

    input:focus, textarea:focus, select:focus {
      outline: none;
      border-color: var(--primary);
      background: white;
    }

    input[readonly] {
      background: #f1f5f9;
      color: #94a3b8;
      cursor: not-allowed;
    }

    .update-btn {
      width: 100%;
      padding: 16px;
      background: #10b981;
      color: white;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .update-btn:hover {
      background: #059669;
      transform: scale(1.02);
    }
  </style>
</head>
<body>

<div class="edit-container">
  <a href="/" class="back-link">← Return to Dashboard</a>
  <h2>Edit Task</h2>

  <form action="/update-todo/<%= todo.id %>" method="post">
    <label>Reference ID</label>
    <input type="text" value="ID: <%= todo.id %>" readonly>

    <label>Title</label>
    <input type="text" name="title" value="<%= todo.title %>" required>

    <label>Description</label>
    <textarea name="description" rows="3"><%= todo.description %></textarea>

    <div style="display: flex; gap: 16px;">
      <div style="flex: 1;">
        <label>Date</label>
        <input type="date" name="date" value="<%= todo.date %>" required>
      </div>
      <div style="flex: 1;">
        <label>Time</label>
        <input type="time" name="time" value="<%= todo.time %>">
      </div>
    </div>

    <label>Priority Level</label>
    <select name="priority">
      <option value="Low" <%= todo.priority === 'Low' ? 'selected' : '' %>>Low Priority</option>
      <option value="Medium" <%= todo.priority === 'Medium' ? 'selected' : '' %>>Medium Priority</option>
      <option value="High" <%= todo.priority === 'High' ? 'selected' : '' %>>High Priority</option>
    </select>

    <label>Current Status</label>
    <select name="status">
      <option value="Pending" <%= todo.status === 'Pending' ? 'selected' : '' %>>Pending</option>
      <option value="Completed" <%= todo.status === 'Completed' ? 'selected' : '' %>>Completed</option>
    </select>

    <button type="submit" class="update-btn">Save Changes</button>
  </form>
</div>

</body>
</html>
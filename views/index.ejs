<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>WorkOS | Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <style>
    /* --- 1. Variables & Global Styles --- */
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --bg-dark: #0f172a;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #f8fafc;
      background-image: radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.05) 0px, transparent 50%);
      color: var(--text-main);
      min-height: 100vh;
      padding: 40px 20px;
    }

    /* --- 2. Layout Container --- */
    .app-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .header-section {
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-section h1 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.025em;
      margin: 0;
    }

    /* --- 3. Form Card --- */
    .form-card {
      background: var(--card-bg);
      padding: 24px;
      border-radius: 16px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border-color);
      margin-bottom: 40px;
    }

    .todo-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .full-width {
      grid-column: 1 / -1;
    }

    input, select, textarea {
      padding: 12px 16px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      font-size: 14px;
      background: #fcfdfe;
      transition: all 0.2s ease;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
      background: #fff;
    }

    .submit-btn {
      background: var(--primary);
      color: white;
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .submit-btn:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }

    /* --- 4. Table Section --- */
    .table-container {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border-color);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      background: #f1f5f9;
      padding: 16px 24px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    td {
      padding: 18px 24px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover {
      background-color: #fcfdfe;
    }

    /* --- 5. Badges & Buttons --- */
    .badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .p-High { background: #fee2e2; color: #b91c1c; }
    .p-Medium { background: #fef3c7; color: #92400e; }
    .p-Low { background: #dcfce7; color: #15803d; }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .action-btn {
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      padding: 8px 12px;
      border-radius: 8px;
      transition: 0.2s;
    }

    .edit { color: var(--primary); background: #eef2ff; }
    .delete { color: var(--danger); background: #fef2f2; margin-left: 8px; }

    .edit:hover { background: var(--primary); color: white; }
    .delete:hover { background: var(--danger); color: white; }

  </style>
</head>
<body>

<div class="app-container">
  <div class="header-section">
    <h1>📋 WorkOS Task Manager</h1>
  </div>
  
  <div class="form-card">
    <form action="/add-todo" method="post" class="todo-form">
      <div class="form-group">
        <label>Task Title</label>
        <input type="text" name="title" placeholder="Enter task name..." required>
      </div>

      <div class="form-group">
        <label>Due Date</label>
        <input type="date" name="date" required>
      </div>

      <div class="form-group">
        <label>Time</label>
        <input type="time" name="time">
      </div>

      <div class="form-group">
        <label>Priority</label>
        <select name="priority">
          <option value="Low">Low Priority</option>
          <option value="Medium">Medium Priority</option>
          <option value="High">High Priority</option>
        </select>
      </div>

      <div class="form-group">
        <label>Initial Status</label>
        <select name="status">
          <option value="Pending">Pending</option>
          <option value="Completed">Completed</option>
        </select>
      </div>

      <div class="form-group full-width">
        <label>Description (Optional)</label>
        <textarea name="description" rows="2" placeholder="Add some context..."></textarea>
      </div>

      <button type="submit" class="submit-btn full-width">Create New Task</button>
    </form>
  </div>
  
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>UID</th>
          <th>Task Info</th>
          <th>Due Details</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% todos.forEach(todo => { %>
          <tr>
            <td style="color: #94a3b8; font-weight: 500;">#<%= todo.id %></td>
            <td>
              <div style="font-weight: 700; color: #1e293b;"><%= todo.title %></div>
              <div style="font-size: 12px; color: #64748b;"><%= todo.description %></div>
            </td>
            <td>
              <div style="font-weight: 500;"><%= todo.date %></div>
              <div style="font-size: 12px; color: #94a3b8;"><%= todo.time %></div>
            </td>
            <td><span class="badge p-<%= todo.priority %>"><%= todo.priority %></span></td>
            <td>
              <div class="status-pill">
                <span class="status-dot" style="background-color: <%= todo.status === 'Completed' ? 'var(--success)' : 'var(--warning)' %>"></span>
                <span style="font-weight: 500;"><%= todo.status %></span>
              </div>
            </td>
            <td>
              <a href="/edit-todo/<%= todo.id %>" class="action-btn edit">Edit</a>
              <a href="/delete-todo/<%= todo.id %>" class="action-btn delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

</body>
</html>